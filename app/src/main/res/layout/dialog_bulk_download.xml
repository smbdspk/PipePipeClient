<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingVertical="8dp">

    <!-- ── Format ──────────────────────────────────────────────── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/bulk_download_format_label"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/bulkFormatGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/bulkRadioVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/video" />

        <RadioButton
            android:id="@+id/bulkRadioAudio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bulk_download_audio_only" />

    </RadioGroup>

    <!-- ── Quality (hidden when audio is selected) ─────────────── -->
    <LinearLayout
        android:id="@+id/bulkQualitySection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/bulk_download_quality_label"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/bulkQualitySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <!-- ── Existing file behaviour ─────────────────────────────── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/bulk_download_existing_file_label"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/bulkBehaviorGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/bulkRadioSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/bulk_download_skip" />

        <RadioButton
            android:id="@+id/bulkRadioOverwrite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overwrite" />

        <RadioButton
            android:id="@+id/bulkRadioUniqueName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/generate_unique_name" />

    </RadioGroup>

    <!-- ── Fetch threads ──────────────────────────────────────────── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/bulk_download_fetch_threads_label"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/bulkFetchThreadsCount"
            android:layout_width="25dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingLeft="2dp"
            android:text="3" />

        <SeekBar
            android:id="@+id/bulkFetchThreads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="9"
            android:progress="2" />

    </LinearLayout>

</LinearLayout>
